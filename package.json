{
  "name": "redis-in-typescript",
  "version": "0.1.0",
  "description": "A from-scratch Redis server clone implementing the RESP protocol and core data structures in TypeScript/Node.js.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "redis-in-typescript": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "ioredis": "^5.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
